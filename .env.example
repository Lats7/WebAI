# Copy these into your host's environment settings (for Vercel: Project, Settings,
# Environment Variables). Do not commit real values.

# Email service API key (Resend). Without this the form opens the visitor's email app instead.
RESEND_API_KEY=

# Sender for brief notifications. The domain must be verified with the email service.
CONTACT_FROM="WebAI ProTech website <website@webaiprotech.com>"

# Where briefs are delivered. Defaults to the address in lib/constants.ts.
CONTACT_TO=
