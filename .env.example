# Copy these into your host's environment settings (for Vercel: Project, Settings,
# Environment Variables). Do not commit real values.

# Email service API key (Resend). Without this the brief form opens the visitor's
# email app instead, and the self-check hides its "email me my results" form.
RESEND_API_KEY=

# Sender for briefs and self-check results. The domain must be verified with the email service.
CONTACT_FROM="WebAI ProTech website <website@webaiprotech.com>"

# The business inbox: where briefs and self-check notes are delivered, and where
# replies to a results email go. Defaults to the address in lib/constants.ts.
CONTACT_TO=

# Optional "book a call" link (Google Calendar appointment page, Cal.com, Calendly).
# Booking buttons stay hidden until this is set. Must start with https://.
NEXT_PUBLIC_BOOKING_URL=
